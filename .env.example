# Environment variables for Resource Reservation Management System

# PostgreSQL connection string
# Matches the docker-compose.yml configuration:
# User: postgres, Password: postgres, Host: localhost, Port: 5432, Database: resource_reservation_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resource_reservation_db?schema=public"

# Application Settings
NEXT_PUBLIC_APP_NAME="SyncSpace Resource Reservation System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
